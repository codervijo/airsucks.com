{
  // Deploy-time Worker config. Used ONLY by `wrangler deploy` (CI deploy
  // command: `npx wrangler deploy -c wrangler.deploy.jsonc`).
  //
  // Why separate from wrangler.jsonc: the root wrangler.jsonc has
  // `main: src/server.ts` for dev/build (the TanStack Start vite plugin needs
  // the SOURCE entry). But `wrangler deploy` against that re-bundles the source
  // from scratch and fails to resolve TanStack Start's virtual entries
  // (`#tanstack-router-entry` / `#tanstack-start-entry`), which only the vite
  // plugin provides at build time. The deploy must ship the ALREADY-BUILT
  // worker (`dist/server/server.js`, virtual entries resolved) + the
  // prerendered static assets (`dist/client`). Verified via `wrangler deploy
  // --dry-run` 2026-06-14.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airsucks",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": { "directory": "dist/client", "binding": "ASSETS" }
}
