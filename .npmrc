# Hoist transitive deps to the top-level node_modules.
#
# Vite/Rollup don't traverse pnpm's strict .pnpm/ symlink layout when resolving
# a package's *transitive* imports (e.g. @tanstack/react-query importing
# @tanstack/query-core). On a clean CI `pnpm install` that surfaces as
# "Rollup failed to resolve import" build failures, even though a local flat
# node_modules resolves fine. Hoisting makes the CI layout match what builds
# locally. Required for the tanstack + @cloudflare/vite-plugin stack.
shamefully-hoist=true
